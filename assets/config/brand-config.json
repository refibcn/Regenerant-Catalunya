{
  "colors": {
    "allowed": ["#214033", "#E6DFD7", "#092045", "#6B4EA3", "#E67E50"],
    "tolerance": 5
  },
  "logo": {
    "minSize": 32,
    "maxSize": 1024,
    "requiredFormats": ["svg", "png"]
  },
  "typography": {
    "fontFamily": "Inter",
    "sizes": {
      "h1": "2.5rem",
      "h2": "2rem",
      "body": "1.125rem"
    }
  },
  "patterns": {
    "allowedTypes": ["dots", "lines", "squares", "crosshatch"],
    "requiredConsistency": true
  }
}
